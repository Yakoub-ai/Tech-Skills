{
  "name": "Tech Hub Skills",
  "description": "200+ production-ready AI agent skills with hierarchical multi-agent orchestration",
  "version": "3.0.0",
  "agent_system": {
    "enabled": true,
    "orchestrator": ".claude/agents/orchestrator-agent.md",
    "execution_protocol": ".claude/agents/EXECUTION.md",
    "skill_reference": ".claude/agents/SKILL-REFERENCE.md",
    "quality_gates": ".claude/agents/QUALITY-GATES.md",
    "user_protocol": ".claude/agents/USER-PROTOCOL.md",
    "context_protocol": ".claude/agents/CONTEXT-PROTOCOL.md"
  },
  "commands": {
    "prefix": "/",
    "available": [
      {
        "name": "orchestrator",
        "description": "Full analysis, planning, and multi-domain coordination",
        "file": ".claude/commands/orchestrator.md"
      },
      {
        "name": "ai",
        "description": "AI/ML tasks - routes to AI/ML Lead",
        "agent": "@ai-ml-lead"
      },
      {
        "name": "platform",
        "description": "DevOps/infrastructure - routes to Platform Lead",
        "agent": "@platform-lead"
      },
      {
        "name": "security",
        "description": "Security/compliance - routes to Security Lead",
        "agent": "@security-lead"
      },
      {
        "name": "data",
        "description": "Data engineering - routes to Data Lead",
        "agent": "@data-lead"
      },
      {
        "name": "product",
        "description": "Product development - routes to Product Lead",
        "agent": "@product-lead"
      },
      {
        "name": "brainstorm",
        "description": "Architecture decisions, solution discovery, project strategy",
        "agent": "@brainstorm-architect"
      }
    ]
  },
  "directories": {
    "agents": ".claude/agents",
    "specialists": ".claude/agents/specialists",
    "skills": ".claude/skills",
    "skill_docs": ".claude/skill-docs",
    "roles": ".claude/roles",
    "commands": ".claude/commands",
    "hooks": ".claude/hooks",
    "templates": ".claude/templates",
    "state": ".claude/state"
  },
  "registries": {
    "skills": ".claude/agents/SKILL-REGISTRY.md",
    "roles": ".claude/agents/ROLE-REGISTRY.md",
    "reference": ".claude/agents/SKILL-REFERENCE.md"
  },
  "protocols": {
    "execution": ".claude/agents/EXECUTION.md",
    "context": ".claude/agents/CONTEXT-PROTOCOL.md",
    "user_communication": ".claude/agents/USER-PROTOCOL.md",
    "quality": ".claude/agents/QUALITY-GATES.md",
    "agent_schema": ".claude/agents/agent-schema.md",
    "session": ".claude/agents/SESSION-PROTOCOL.md"
  },
  "documentation": {
    "main": ".claude/README.md",
    "agents": ".claude/AGENTS.md",
    "quickstart": ".claude/QUICKSTART.md"
  }
}
